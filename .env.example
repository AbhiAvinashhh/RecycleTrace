# RecycleTrace Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# Flask
FLASK_SECRET_KEY=your-very-long-random-secret-key-here
FLASK_ENV=development
FLASK_DEBUG=1

# MongoDB
MONGO_URI=mongodb://localhost:27017/recycletrace_db
# For MongoDB Atlas use:
# MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/recycletrace_db?retryWrites=true&w=majority

# App Config
APP_HOST=0.0.0.0
APP_PORT=5000
BASE_URL=http://localhost:5000

# Upload Settings
UPLOAD_FOLDER=uploads
MAX_CONTENT_LENGTH_MB=10

# Weight reconciliation tolerance (percent)
WEIGHT_TOLERANCE_PERCENT=5

# Rate limiting (requests per minute)
LOGIN_RATE_LIMIT=10
